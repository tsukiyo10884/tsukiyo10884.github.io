rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.isAdmin == false;
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.isAdmin == resource.data.isAdmin;
    }

    match /characters/{characterId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /dungeons/{dungeonId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /recruitments/{recruitmentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      // Once a recruitment is disbanded it's locked: no further edits or status
      // changes, but the creator can still delete it to clean up their list.
      allow update: if isSignedIn() && resource.data.creatorId == request.auth.uid
        && resource.data.status != 'disbanded';
      allow delete: if isSignedIn() && resource.data.creatorId == request.auth.uid;

      match /responses/{uid} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == uid;
      }
    }
  }
}
